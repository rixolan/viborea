{
  "name": "viborea-chatwoot-bot",
  "account_id": "707c4355e033f613ab2ba527f1d8e811",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CHATWOOT_ACCOUNT_ID": "1",
    "CHATWOOT_INBOX_ID": "1",
    "CHATWOOT_HUMAN_ASSIGNEE_ID": "1",
    "CHATWOOT_HANDOFF_NAME": "alguien del equipo"
  },
  "secrets": {
    "required": ["CHATWOOT_BASE_URL", "CHATWOOT_ACCESS_TOKEN"]
  },
  "env": {
    "academia-dg": {
      "name": "academia-dg-chatwoot-bot",
      "secrets": {
        "required": ["CHATWOOT_BASE_URL", "CHATWOOT_ACCESS_TOKEN"]
      },
      "vars": {
        "CHATWOOT_ACCOUNT_ID": "1",
        "CHATWOOT_INBOX_ID": "2",
        "CHATWOOT_HUMAN_ASSIGNEE_ID": "1",
        "CHATWOOT_HANDOFF_NAME": "Diego"
      }
    }
  }
}
